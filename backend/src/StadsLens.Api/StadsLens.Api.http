@StadsLens_Api_HostAddress = http://localhost:5158

GET {{StadsLens_Api_HostAddress}}/api/routes
Accept: application/json

###

GET {{StadsLens_Api_HostAddress}}/api/routes/1/landmarks
Accept: application/json

###

# Landmark in meerdere routes: de kathedraal en het stadhuis zitten in route 1 en route 2.
GET {{StadsLens_Api_HostAddress}}/api/routes/2/landmarks
Accept: application/json

###

# RouteIds toont alle routes waarin de landmark zit.
GET {{StadsLens_Api_HostAddress}}/api/landmarks/by-tag/stadhuis-mechelen
Accept: application/json

###

# Vertaald naar het Engels (Azure AI Translator). "language" in de response zegt in welke taal de tekst staat.
GET {{StadsLens_Api_HostAddress}}/api/landmarks/1?language=en
Accept: application/json

###

# De geschiedenis voorgelezen als mp3 (Azure AI Speech). Gebruik language=nl of language=en.
GET {{StadsLens_Api_HostAddress}}/api/landmarks/1/audio?language=en

###

POST {{StadsLens_Api_HostAddress}}/api/routes/plan
Content-Type: application/json

{
  "routeId": 2,
  "distanceKm": 5
}

###

POST {{StadsLens_Api_HostAddress}}/api/users
Content-Type: application/json

{
  "name": "Testgebruiker",
  "preferredLanguage": "nl"
}

###

POST {{StadsLens_Api_HostAddress}}/api/visits
Content-Type: application/json

{
  "userId": 1,
  "landmarkId": 1
}

###
