<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StadsLens.Mobile.ViewModels"
             xmlns:loc="clr-namespace:StadsLens.Mobile.Helpers"
             x:Class="StadsLens.Mobile.Views.RouteMapPage"
             x:DataType="vm:IMapViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">
    <Grid>
        <WebView>
            <WebView.Source>
                <HtmlWebViewSource Html="{Binding MapHtml}" />
            </WebView.Source>
        </WebView>
        <Button Text="{loc:Translate Common_Back}"
                Command="{Binding GoBackCommand}"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="16,40,0,0"
                ZIndex="1" />
    </Grid>
</ContentPage>
