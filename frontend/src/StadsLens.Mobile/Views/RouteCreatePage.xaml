<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StadsLens.Mobile.ViewModels"
    xmlns:loc="clr-namespace:StadsLens.Mobile.Helpers"
             xmlns:behaviors="clr-namespace:StadsLens.Mobile.Behaviors"
    xmlns:models="clr-namespace:StadsLens.Mobile.Models"
    x:Class="StadsLens.Mobile.Views.RouteCreatePage"
    x:DataType="vm:IRouteCreateViewModel"
    Title="{loc:Translate Tab_CreateRoute}">

    <Grid Padding="12"
          RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
          RowSpacing="8">

        <Label Text="{loc:Translate RouteCreate_Header}"
               Style="{StaticResource Headline}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Text="{loc:Translate RouteCreate_UseCurrentLocation}" VerticalOptions="Center" />
            <Switch Grid.Column="1" IsToggled="{Binding UseCurrentLocation}" VerticalOptions="Center" />
        </Grid>

        <Entry
            Grid.Row="2"
            Placeholder="{loc:Translate RouteCreate_SearchPlaceholder}"
            Text="{Binding StartAddress}"
            IsEnabled="{Binding IsAddressEnabled}"
            ClearButtonVisibility="WhileEditing"
            ReturnType="Search" />

        <Grid Grid.Row="3" ColumnDefinitions="140,*" ColumnSpacing="10">
            <Border Padding="8,0" Stroke="#D7DFEA" StrokeShape="RoundRectangle 8"
                    VerticalOptions="Center" HeightRequest="48">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Placeholder="{loc:Translate RouteCreate_DistancePlaceholder}"
                           Text="{Binding DistanceKm}"
                           Keyboard="Numeric"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="km" FontAttributes="Bold" TextColor="Gray"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <Button
                Grid.Column="1"
                Text="{loc:Translate RouteCreate_Generate}"
                Command="{Binding CreateRouteCommand}"
                IsEnabled="{Binding IsNotBusy}"
                FontSize="15"
                FontAttributes="Bold"
                Padding="18,12"
                MinimumHeightRequest="50" />
        </Grid>

        <Grid Grid.Row="4">
            <WebView>
                <WebView.Source>
                    <HtmlWebViewSource Html="{Binding MapHtml}" />
                </WebView.Source>
            </WebView>

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>

        <VerticalStackLayout Grid.Row="5" Spacing="4">
            <Label
                Text="{Binding ResultSummary}"
                FontAttributes="Bold"
                FontSize="15" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
        </VerticalStackLayout>

        <!-- Tik op een bezienswaardigheid om de detailpagina te openen. -->
        <CollectionView
            Grid.Row="6"
            ItemsSource="{Binding RouteLandmarks}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedLandmark}"
            SelectionChangedCommand="{Binding GoToLandmarkDetailCommand}"
            HeightRequest="120">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Landmark">
                    <Grid Padding="4,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Grid.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Grid.Behaviors>
                        <Label Text="📍" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Suggesties als laag over de rest van de pagina, net onder het zoekveld (staat als laatste = bovenaan). -->
        <Border
            Grid.Row="3"
            Grid.RowSpan="2"
            VerticalOptions="Start"
            IsVisible="{Binding HasLocationSuggestions}"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
            StrokeShape="RoundRectangle 8"
            ZIndex="1">
            <Border.Shadow>
                <Shadow Opacity="0.3" Radius="8" Offset="0,4" />
            </Border.Shadow>

            <CollectionView
                ItemsSource="{Binding LocationSuggestions}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedSuggestion}"
                MaximumHeightRequest="250">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LocationSuggestion">
                        <Grid Padding="12,10" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Grid.Behaviors>
                                <behaviors:HandCursorBehavior />
                            </Grid.Behaviors>
                            <Label Text="📍" FontSize="18" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Label}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

    </Grid>
</ContentPage>
