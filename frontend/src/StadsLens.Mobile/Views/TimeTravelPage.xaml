<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StadsLens.Mobile.ViewModels"
             xmlns:loc="clr-namespace:StadsLens.Mobile.Helpers"
             xmlns:models="clr-namespace:StadsLens.Mobile.Models"
             x:Class="StadsLens.Mobile.Views.TimeTravelPage"
             x:DataType="vm:ITimeTravelViewModel"
             Title="{Binding Title}">

    <!-- Het beeld vult de vrije ruimte, zodat de schuifregelaar altijd zichtbaar blijft zonder te scrollen. -->
    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="12">
        <VerticalStackLayout Spacing="8">
            <Button Text="{loc:Translate Common_Back}"
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource BackButton}" />

            <Label Text="{Binding Landmark.Name}" Style="{StaticResource Headline}" />
            <Label Text="{loc:Translate TimeTravel_Hint}" />
            <Label Text="{loc:Translate TimeTravel_NoHistory}" IsVisible="{Binding HasNoHistory}" FontSize="13" TextColor="Gray" />
        </VerticalStackLayout>

        <Border Grid.Row="1" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light=#F4F5F6, Dark=#2B2B2B}">
            <!-- Alle beelden liggen op elkaar; de schuifregelaar bepaalt welk beeld doorschijnt. -->
            <Grid BindableLayout.ItemsSource="{Binding Stops}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:TimeTravelStop">
                        <Image Source="{Binding Image}" Aspect="AspectFit" Opacity="{Binding Opacity}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Label Text="{Binding CurrentDate}" FontAttributes="Bold" FontSize="22" HorizontalTextAlignment="Center" />
            <Label Text="{Binding CurrentCaption}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding CurrentCredit}" FontSize="12" TextColor="Gray" HorizontalTextAlignment="Center" />

            <Slider Minimum="0" Maximum="{Binding SliderMaximum}" Value="{Binding SliderValue}" />
            <Grid ColumnDefinitions="*,*">
                <Label Text="{loc:Translate TimeTravel_Past}" FontSize="13" />
                <Label Grid.Column="1" Text="{loc:Translate TimeTravel_Future}" FontSize="13" HorizontalTextAlignment="End" />
            </Grid>

            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsBusy}">
                <ActivityIndicator IsRunning="{Binding IsBusy}" />
                <Label Text="{loc:Translate TimeTravel_Loading}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                <Button Text="{loc:Translate TimeTravel_Retry}" Command="{Binding LoadImagesCommand}" HorizontalOptions="Start" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
