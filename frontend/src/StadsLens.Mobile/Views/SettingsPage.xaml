<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StadsLens.Mobile.ViewModels"
             xmlns:models="clr-namespace:StadsLens.Mobile.Models"
             xmlns:loc="clr-namespace:StadsLens.Mobile.Helpers"
             x:Class="StadsLens.Mobile.Views.SettingsPage"
             x:DataType="vm:ISettingsViewModel"
             Title="{loc:Translate Tab_Settings}">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="{loc:Translate Tab_Settings}" Style="{StaticResource Headline}" />

        <Label Text="{loc:Translate Settings_Language}" FontAttributes="Bold" />
        <Picker ItemsSource="{Binding Languages}"
                ItemDisplayBinding="{Binding DisplayName, x:DataType=models:LanguageOption}"
                SelectedItem="{Binding SelectedLanguage}" />
        <Label Text="{loc:Translate Settings_LanguageInfo}" FontSize="12" TextColor="Gray" />

        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <Label Text="{loc:Translate Settings_AutoRead}" FontAttributes="Bold" VerticalOptions="Center" />
            <Switch Grid.Column="1" IsToggled="{Binding AutoReadAloud}" />
        </Grid>
        <Label Text="{loc:Translate Settings_AutoReadInfo}" FontSize="12" TextColor="Gray" />

        <Label Text="{Binding LoggedInAs}" Margin="0,24,0,0" />
        <Button Text="{loc:Translate Settings_Logout}" Command="{Binding LogoutCommand}" />
    </VerticalStackLayout>

</ContentPage>
