<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StadsLens.Mobile.ViewModels"
             xmlns:models="clr-namespace:StadsLens.Mobile.Models"
             x:Class="StadsLens.Mobile.Views.SettingsPage"
             x:DataType="vm:ISettingsViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="{Binding Title}" Style="{StaticResource Headline}" />

        <Label Text="Taal van de bezienswaardigheden" FontAttributes="Bold" />
        <Picker ItemsSource="{Binding Languages}"
                ItemDisplayBinding="{Binding DisplayName, x:DataType=models:LanguageOption}"
                SelectedItem="{Binding SelectedLanguage}" />
        <Label Text="Namen en geschiedenis worden vertaald met Azure AI Translator en voorgelezen met Azure AI Speech."
               FontSize="12" TextColor="Gray" />
    </VerticalStackLayout>

</ContentPage>
