<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StadsLens.Mobile.ViewModels"
             x:Class="StadsLens.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="StadsLens" Style="{StaticResource Headline}" />
        <Label Text="Ontdek de stad door je camera." HorizontalOptions="Center" />
        <Entry Placeholder="Je naam" Text="{Binding Name}" />
        <Button Text="Start" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>

</ContentPage>
