<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StadsLens.Mobile.ViewModels"
             xmlns:loc="clr-namespace:StadsLens.Mobile.Helpers"
             x:Class="StadsLens.Mobile.Views.LandmarkDetailPage"
             x:DataType="vm:ILandmarkDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <Button Text="{loc:Translate Common_Back}"
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource BackButton}" />

            <VerticalStackLayout Spacing="4" IsVisible="{Binding HasImage}">
                <Border HeightRequest="220" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                </Border>
                <Label Text="{Binding Landmark.ImageCredit}" FontSize="12" TextColor="Gray" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding Landmark.Name}" Style="{StaticResource Headline}" />
                <Border HorizontalOptions="Start" Padding="10,5" StrokeThickness="0"
                        BackgroundColor="#EAF5EE" StrokeShape="RoundRectangle 12"
                        IsVisible="{Binding IsVisited}">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="✓" TextColor="#16834A" FontAttributes="Bold" />
                        <Label Text="{loc:Translate Landmark_Visited}" TextColor="#16834A" FontAttributes="Bold" />
                    </HorizontalStackLayout>
                </Border>
                <Label Text="{Binding VisitCountText}" FontSize="13" TextColor="Gray"
                       IsVisible="{Binding IsVisited}" />
            </VerticalStackLayout>

            <Label Text="{Binding TranslationWarning}" TextColor="DarkOrange"
                   IsVisible="{Binding HasTranslationWarning}" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   Style="{StaticResource ErrorText}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Border Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light=#F4F5F6, Dark=#2B2B2B}"
                    IsVisible="{Binding CanViewHistory}">
                <Label Text="{Binding Landmark.History}" FontSize="16" LineHeight="1.35" />
            </Border>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsNotVisited}">
                <Label Text="{loc:Translate Landmark_ScanToUnlock}" TextColor="Gray" />
                <Button Text="{loc:Translate Landmark_ScanThis}"
                        Command="{Binding ScanThisCommand}" />
            </VerticalStackLayout>

            <Button Text="{Binding ReadAloudText}" Command="{Binding ReadAloudCommand}"
                    IsVisible="{Binding CanViewHistory}" HorizontalOptions="Start" />

            <Button Text="{loc:Translate Landmark_TimeTravel}" Command="{Binding GoToTimeTravelCommand}"
                    IsVisible="{Binding CanViewHistory}" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
