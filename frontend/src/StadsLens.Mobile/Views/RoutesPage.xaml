<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StadsLens.Mobile.ViewModels"
             xmlns:models="clr-namespace:StadsLens.Mobile.Models"
             x:Class="StadsLens.Mobile.Views.RoutesPage"
             x:DataType="vm:RoutesViewModel"
             Title="{Binding Title}">

    <RefreshView Command="{Binding LoadRoutesCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Routes}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Trek naar beneden om de routes te laden." HorizontalOptions="Center" Margin="24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Route">
                    <Border Margin="16,8" Padding="16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RoutesViewModel}}, Path=GoToRouteDetailCommand, x:DataType=vm:RoutesViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" />
                            <Label Text="{Binding Description}" />
                            <Label Text="{Binding LandmarkCount, StringFormat='{0} bezienswaardigheden'}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
