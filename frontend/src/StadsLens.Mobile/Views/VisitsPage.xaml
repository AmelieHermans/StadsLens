<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StadsLens.Mobile.ViewModels"
             xmlns:models="clr-namespace:StadsLens.Mobile.Models"
             x:Class="StadsLens.Mobile.Views.VisitsPage"
             x:DataType="vm:IVisitsViewModel"
             Title="{Binding Title}">

    <RefreshView Command="{Binding LoadVisitsCommand}" IsRefreshing="{Binding IsRefreshing}">
        <CollectionView ItemsSource="{Binding Visits}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Je hebt nog geen bezienswaardigheden bezocht." HorizontalOptions="Center" Margin="24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Visit">
                    <Border Margin="16,8" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding LandmarkName}" FontAttributes="Bold" FontSize="18" />
                            <Label Text="{Binding VisitedAtLocal, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
