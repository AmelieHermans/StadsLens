<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StadsLens.Mobile.ViewModels"
    xmlns:models="clr-namespace:StadsLens.Mobile.Models"
    x:Class="StadsLens.Mobile.Views.RouteCreatePage"
    x:Name="RoutePage"
    x:DataType="vm:RouteCreateViewModel"
    Title="{Binding Title}">

    <Grid Padding="12"
          RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
          RowSpacing="8">

        <Label Text="Maak je eigen wandelroute"
               Style="{StaticResource Headline}" />

        <VerticalStackLayout Grid.Row="1" Spacing="6">
            <Entry
    Placeholder="Zoek een adres of plaats..."
    Text="{Binding StartAddress, Mode=TwoWay}"
    TextChanged="OnStartAddressTextChanged"
    ClearButtonVisibility="WhileEditing"
    ReturnType="Search" />

            <CollectionView
    ItemsSource="{Binding LocationSuggestions}"
    IsVisible="{Binding HasLocationSuggestions}"
    SelectionMode="Single"
    SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
    MaximumHeightRequest="250">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LocationSuggestion">
                        <Grid
                Padding="12,10"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12">

                            <Label
                    Text="📍"
                    FontSize="18"
                    VerticalOptions="Center" />

                            <Label
                    Grid.Column="1"
                    Text="{Binding Label}"
                    VerticalOptions="Center"
                    LineBreakMode="WordWrap" />

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button
                Text="Gebruik huidige locatie"
                Command="{Binding UseCurrentLocationCommand}" />
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="2" Spacing="8">
            <Entry
                Placeholder="Afstand in km"
                Text="{Binding DistanceKm}"
                Keyboard="Numeric"
                WidthRequest="130" />

            <Button
                Text="Genereer route"
                Command="{Binding CreateRouteCommand}"
                IsEnabled="{Binding IsNotBusy}"
                HorizontalOptions="FillAndExpand" />
        </HorizontalStackLayout>

        <Grid Grid.Row="3">
            <WebView Source="{Binding MapSource}" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>

        <Label
            Grid.Row="4"
            Text="{Binding ResultSummary}"
            FontAttributes="Bold"
            FontSize="15"
            VerticalOptions="Center" />

        <CollectionView
            Grid.Row="5"
            ItemsSource="{Binding RouteLandmarks}"
            HeightRequest="120">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Landmark">
                    <Grid Padding="4" ColumnDefinitions="Auto,*">
                        <Label Text="📍" VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding Name}"
                            VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
