# Kopieer dit bestand naar .env en vul je eigen key in.
OpenRouteService__ApiKey=plak-hier-je-openrouteservice-key

# Azure AI Translator (Azure-portal > Translator-resource > Keys and Endpoint)
Translator__Key=plak-hier-je-translator-key
Translator__Region=germanywestcentral
Translator__Endpoint=https://api.cognitive.microsofttranslator.com/

# Azure AI Speech (Azure-portal > Speech-resource > Keys and Endpoint)
Speech__Key=plak-hier-je-speech-key
Speech__Region=germanywestcentral
