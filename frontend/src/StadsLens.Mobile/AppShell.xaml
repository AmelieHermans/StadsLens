<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StadsLens.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StadsLens.Mobile.Views"
    xmlns:loc="clr-namespace:StadsLens.Mobile.Helpers"
    Title="StadsLens"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <TabBar Route="main">
        <!-- Een expliciete Tab met de titel: bij een impliciete tab liep de titel op Windows één taal achter. -->
        <Tab Title="{loc:Translate Tab_Routes}" Route="routes">
            <ShellContent ContentTemplate="{DataTemplate views:RoutesPage}" />
        </Tab>
        <Tab Title="{loc:Translate Tab_Visits}" Route="visits">
            <ShellContent ContentTemplate="{DataTemplate views:VisitsPage}" />
        </Tab>
        <Tab Title="{loc:Translate Tab_Settings}" Route="settings">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
        </Tab>
        <Tab Title="{loc:Translate Tab_CreateRoute}" Route="create-route">
            <ShellContent ContentTemplate="{DataTemplate views:RouteCreatePage}" />
        </Tab>
    </TabBar>

</Shell>
