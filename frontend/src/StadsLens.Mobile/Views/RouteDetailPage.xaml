<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StadsLens.Mobile.ViewModels"
             xmlns:models="clr-namespace:StadsLens.Mobile.Models"
             x:Class="StadsLens.Mobile.Views.RouteDetailPage"
             x:DataType="vm:IRouteDetailViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">
        <Label Text="{Binding SelectedRoute.Description}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Landmarks}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Landmark">
                    <Label Text="{Binding Name}" Padding="0,8" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="2" Spacing="12" HorizontalOptions="Center">
            <Button Text="Kaart" Command="{Binding GoToMapCommand}" />
            <Button Text="Scan gebouw" Command="{Binding GoToScanCommand}" />
        </HorizontalStackLayout>
    </Grid>

</ContentPage>
